# ─────────────────────────────────────────────────────────────────────
# AI Chat Service — environment template.
# Copy to `.env` for local runs. In Docker Compose these come from the
# container environment. NEVER commit a real `.env`.
# Field names map 1:1 to settings in app/config.py (case-insensitive).
# ─────────────────────────────────────────────────────────────────────

# Runtime
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=info                   # debug | info | warning | error
HOST=0.0.0.0
PORT=8002                        # internal port; NOT published to the host

# Gateway trust — enforced by the X-Internal-Token guard.
INTERNAL_SERVICE_TOKEN=          # shared secret; the Hono gateway sends this header

# Shared infrastructure (declared now; clients wired in later batches).
MONGO_URI=                       # same MongoDB as the backend (read-mostly)
# Database name. MUST match the backend's database. The backend uses mongoose,
# which defaults to "test" when MONGO_URI has no database in its path
# (…mongodb.net/?retryWrites=…). Leave empty only if MONGO_URI encodes a db.
MONGO_DB=test
REDIS_URL=redis://redis:6379     # same Redis instance the backend uses

# Qdrant (vector DB). Client + collection bootstrap live in app/rag.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_PUBLIC=content_public
QDRANT_COLLECTION_PRIVATE=content_private
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=Cosine

# Embeddings (engine lives in app/rag/embedder.py).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_CACHE_TTL=86400
EMBEDDING_BATCH_SIZE=32

# AI — LLM generation (provider-agnostic facade in app/llm/provider.py).
LLM_PROVIDER=groq                # selects the generation backend

# Groq generation (app/llm/groq_client.py, lazy-loaded on first use).
# Model names are configurable here and NEVER hardcoded in code.
GROQ_API_KEY=                                    # required to activate Groq; leave empty to disable
GROQ_MODEL=llama-3.3-70b-versatile               # primary model
GROQ_MODEL_FALLBACKS=qwen/qwen3-32b,llama-3.1-8b-instant  # ordered fallbacks (comma-separated)
GROQ_TEMPERATURE=0.1             # low for factual, grounded answers
GROQ_MAX_OUTPUT_TOKENS=2048      # response token cap (cost + latency)
GROQ_TIMEOUT_SECONDS=30          # per-request timeout
GROQ_MAX_RETRIES=1               # transient-error retries per model
GROQ_WHISPER_MODEL=whisper-large-v3  # audio transcription model (live voice-channel captions) — full model, not -turbo, for better Hinglish/code-switch accuracy
